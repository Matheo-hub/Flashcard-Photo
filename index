<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FlashMaster - Flashcards Visuelles</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0284c7',
                            700: '#0369a1',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        /* 3D Card Flip Styling */
        .perspective-1000 {
            perspective: 1000px;
        }
        
        .transform-style-3d {
            transform-style: preserve-3d;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        
        .rotate-y-180 {
            transform: rotateY(180deg);
        }

        /* Prevent image context menu and text selection during drag/swipe */
        .no-select {
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            user-select: none;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-full flex flex-col transition-colors duration-200">

    <!-- Header Navigation -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-sky-500/20 shrink-0">
                    <i class="fa-solid fa-layer-group text-lg sm:text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg sm:text-xl leading-none bg-gradient-to-r from-sky-600 to-indigo-600 bg-clip-text text-transparent">FlashMaster</h1>
                    <span class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium">Révision Visuelle Photo</span>
                </div>
            </div>

            <!-- View Tabs -->
            <div class="flex items-center gap-1.5 sm:gap-2 bg-slate-100 dark:bg-slate-700/60 p-1 rounded-xl">
                <button id="tab-study" onclick="switchTab('study')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center gap-1.5 bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-sm">
                    <i class="fa-solid fa-graduation-cap"></i> <span>Réviser</span>
                </button>
                <button id="tab-manage" onclick="switchTab('manage')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all flex items-center gap-1.5">
                    <i class="fa-solid fa-sliders"></i> <span class="hidden sm:inline">Gérer</span>
                    <span id="card-count-badge" class="px-1.5 py-0.5 text-[10px] sm:text-xs bg-slate-200 dark:bg-slate-600 rounded-full font-bold">0</span>
                </button>
            </div>

            <!-- Actions Controls -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <button onclick="toggleDarkMode()" title="Changer de thème" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    <i id="theme-icon" class="fa-solid fa-moon text-xs sm:text-sm"></i>
                </button>
                <button onclick="openExportModal()" title="Export / Import JSON" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    <i class="fa-solid fa-file-export text-xs sm:text-sm"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Notification Toast -->
    <div id="toast" class="fixed top-20 right-4 z-50 transform translate-y-[-100%] opacity-0 transition-all duration-300 bg-slate-800 text-white px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-2 text-sm font-medium border border-slate-700">
        <i id="toast-icon" class="fa-solid fa-circle-info text-sky-400"></i>
        <span id="toast-msg">Message</span>
    </div>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 flex flex-col justify-between">

        <!-- ================= STUDY MODE ================= -->
        <section id="section-study" class="flex-1 flex flex-col justify-between items-center max-w-2xl mx-auto w-full">
            
            <!-- Controls Top Bar -->
            <div class="w-full flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <button onclick="shuffleDeck()" class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-1.5 transition shadow-sm">
                        <i class="fa-solid fa-shuffle text-sky-500"></i> <span class="hidden sm:inline">Mélanger</span>
                    </button>
                    <button onclick="resetStudyProgress()" class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-1.5 transition shadow-sm">
                        <i class="fa-solid fa-rotate-left text-amber-500"></i> <span class="hidden sm:inline">Recommencer</span>
                    </button>
                </div>
                
                <span id="progress-text" class="text-xs sm:text-sm font-semibold text-slate-500 dark:text-slate-400">Carte 0 / 0</span>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-slate-200 dark:bg-slate-700 h-1.5 rounded-full mb-4 overflow-hidden">
                <div id="progress-bar" class="bg-gradient-to-r from-sky-500 to-indigo-600 h-full w-0 transition-all duration-300"></div>
            </div>

            <!-- Flashcard Display Box -->
            <div id="flashcard-container" class="w-full flex-1 min-h-[300px] h-[48vh] sm:h-[450px] max-h-[500px] my-auto relative perspective-1000 group cursor-pointer no-select">
                <!-- Empty Deck Message -->
                <div id="empty-deck-msg" class="hidden absolute inset-0 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 flex flex-col items-center justify-center p-6 text-center bg-white/50 dark:bg-slate-800/50">
                    <div class="w-14 h-14 rounded-full bg-sky-100 dark:bg-sky-900/40 text-sky-600 dark:text-sky-400 flex items-center justify-center text-2xl mb-3">
                        <i class="fa-solid fa-images"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-800 dark:text-white mb-1">Aucune carte disponible</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-sm mb-4">Ajoutez des cartes mémoire avec vos photos pour commencer.</p>
                    <button onclick="switchTab('manage'); openAddModal()" class="px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white font-medium rounded-xl shadow-lg shadow-sky-600/30 transition text-xs sm:text-sm flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i> Créer ma première carte
                    </button>
                </div>

                <!-- Flip Element -->
                <div id="card-flipper" class="w-full h-full transform-style-3d relative rounded-2xl shadow-xl shadow-slate-200/60 dark:shadow-none border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800">
                    
                    <!-- RECTO (FRONT) -->
                    <div class="absolute inset-0 w-full h-full rounded-2xl p-4 sm:p-5 flex flex-col justify-between backface-hidden bg-white dark:bg-slate-800 overflow-hidden">
                        <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 shrink-0">
                            <span class="flex items-center gap-1.5"><i class="fa-regular fa-eye"></i> RECTO</span>
                            <span class="text-slate-400 font-normal text-[10px]"><i class="fa-solid fa-arrows-rotate mr-1"></i> Appuyer pour tourner</span>
                        </div>
                        
                        <!-- Front Title -->
                        <div class="text-center py-2 shrink-0">
                            <h2 id="card-front-title" class="text-lg sm:text-xl font-bold text-slate-800 dark:text-white leading-tight">...</h2>
                        </div>

                        <!-- Front Image Container (Takes available space) -->
                        <div class="flex-1 h-0 w-full flex items-center justify-center overflow-hidden rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-700/50 relative">
                            <img id="card-front-img" src="" alt="Photo Recto" class="max-h-full max-w-full w-auto h-auto object-contain rounded-lg hidden" onerror="onImgError(this, 'front')">
                            <div id="card-front-img-placeholder" class="text-slate-400 text-xs flex flex-col items-center gap-2 p-4">
                                <i class="fa-regular fa-image text-3xl opacity-40"></i>
                                <span id="card-front-msg">Pas d'image recto</span>
                            </div>
                        </div>
                    </div>

                    <!-- VERSO (BACK) -->
                    <div class="absolute inset-0 w-full h-full rounded-2xl p-4 sm:p-5 flex flex-col justify-between backface-hidden rotate-y-180 bg-slate-900 text-white dark:bg-slate-950 border-2 border-indigo-500/30 overflow-hidden">
                        <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-indigo-400 shrink-0">
                            <span class="flex items-center gap-1.5"><i class="fa-solid fa-lightbulb"></i> VERSO</span>
                            <span class="text-slate-400 font-normal text-[10px]"><i class="fa-solid fa-arrows-rotate mr-1"></i> Appuyer pour tourner</span>
                        </div>

                        <!-- Back Title / Description -->
                        <div class="text-center py-2 shrink-0">
                            <h2 id="card-back-title" class="text-lg sm:text-xl font-bold text-indigo-100 leading-tight">...</h2>
                        </div>

                        <!-- Back Image Container (Takes available space) -->
                        <div class="flex-1 h-0 w-full flex items-center justify-center overflow-hidden rounded-xl bg-slate-800/80 border border-slate-700/50 relative">
                            <img id="card-back-img" src="" alt="Photo Verso" class="max-h-full max-w-full w-auto h-auto object-contain rounded-lg hidden" onerror="onImgError(this, 'back')">
                            <div id="card-back-img-placeholder" class="text-slate-500 text-xs flex flex-col items-center gap-2 p-4">
                                <i class="fa-regular fa-image text-3xl opacity-40"></i>
                                <span id="card-back-msg">Pas d'image verso</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Bottom Navigation Bar -->
            <div class="w-full flex items-center justify-between mt-4 gap-3">
                <button onclick="prevCard()" id="btn-prev" class="flex-1 py-3 px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center justify-center gap-2 shadow-sm text-sm">
                    <i class="fa-solid fa-arrow-left"></i> Précédent
                </button>
                
                <button onclick="flipCard()" class="py-3 px-4 rounded-xl bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-100 font-bold hover:bg-slate-300 dark:hover:bg-slate-600 active:scale-95 transition flex items-center justify-center gap-2 text-sm shrink-0">
                    <i class="fa-solid fa-rotate"></i> <span class="hidden sm:inline">Retourner</span>
                </button>

                <button onclick="nextCard()" id="btn-next" class="flex-1 py-3 px-3 rounded-xl bg-gradient-to-r from-sky-600 to-indigo-600 text-white font-semibold hover:opacity-95 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center justify-center gap-2 shadow-lg shadow-sky-600/20 text-sm">
                    Suivant <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- Keyboard & Gesture Legend -->
            <div class="mt-3 text-[11px] text-slate-400 dark:text-slate-500 text-center flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
                <span class="sm:hidden"><i class="fa-solid fa-hand-pointer mr-1"></i> Glisser <b>Gaucher/Droite</b> pour changer</span>
                <span class="hidden sm:inline"><kbd class="px-1 py-0.5 bg-slate-200 dark:bg-slate-700 rounded text-[10px]">←</kbd> <kbd class="px-1 py-0.5 bg-slate-200 dark:bg-slate-700 rounded text-[10px]">→</kbd> Naviguer</span>
                <span class="hidden sm:inline"><kbd class="px-1 py-0.5 bg-slate-200 dark:bg-slate-700 rounded text-[10px]">Espace</kbd> Retourner</span>
            </div>

        </section>


        <!-- ================= MANAGE / CREATION MODE ================= -->
        <section id="section-manage" class="hidden flex-1 flex flex-col">
            <!-- Top Controls -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-5">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-white">Vos cartes mémoire</h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Créez, éditez et organisez vos cartes de révision avec photos.</p>
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <button onclick="openAddModal()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-semibold shadow-md shadow-sky-600/20 transition flex items-center justify-center gap-2 text-sm">
                        <i class="fa-solid fa-plus"></i> Nouvelle Carte
                    </button>
                </div>
            </div>

            <!-- Grid Display of Cards -->
            <div id="cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 flex-1">
                <!-- Dynamic cards insertion -->
            </div>
        </section>

    </main>

    <!-- ================= ADD / EDIT MODAL ================= -->
    <div id="modal-card" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
        <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-2xl w-full p-4 sm:p-6 shadow-2xl border border-slate-200 dark:border-slate-700 my-auto">
            <div class="flex items-center justify-between mb-4 border-b border-slate-100 dark:border-slate-700 pb-3">
                <h3 id="modal-title" class="text-lg sm:text-xl font-bold text-slate-800 dark:text-white">Ajouter une Flashcard</h3>
                <button onclick="closeAddModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-lg p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="form-card" onsubmit="saveCardForm(event)" class="space-y-4 sm:space-y-6">
                <input type="hidden" id="card-id">

                <!-- Grid Recto / Verso inputs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                    
                    <!-- RECTO CONFIG -->
                    <div class="bg-slate-50 dark:bg-slate-900/50 p-3.5 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-700 space-y-3">
                        <h4 class="font-bold text-sky-600 dark:text-sky-400 text-xs sm:text-sm flex items-center gap-1.5">
                            <i class="fa-regular fa-eye"></i> RECTO (Question / Image)
                        </h4>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Titre ou Question *</label>
                            <input type="text" id="input-front-title" required placeholder="Ex: Anatomie du Cœur" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-sm focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Photo Recto</label>
                            <div class="space-y-2">
                                <div id="dropzone-front" onclick="document.getElementById('file-front').click()" class="border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-sky-500 dark:hover:border-sky-500 rounded-xl p-3 text-center cursor-pointer transition flex flex-col items-center justify-center bg-white dark:bg-slate-800">
                                    <i class="fa-solid fa-camera text-xl text-slate-400 mb-1"></i>
                                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Prendre / Choisir une photo</span>
                                    <input type="file" id="file-front" accept="image/*" class="hidden" onchange="handleFileUpload(this, 'front')">
                                </div>
                                
                                <input type="url" id="input-front-url" placeholder="ou URL de l'image..." oninput="previewUrlImage('front')" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-xs focus:ring-2 focus:ring-sky-500 focus:outline-none">

                                <!-- Image Preview -->
                                <div id="preview-front-container" class="relative hidden mt-2 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900 h-28 flex items-center justify-center">
                                    <img id="preview-front-img" src="" class="max-h-full max-w-full object-contain">
                                    <button type="button" onclick="clearImage('front')" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs hover:bg-red-600 shadow">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VERSO CONFIG -->
                    <div class="bg-slate-50 dark:bg-slate-900/50 p-3.5 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-700 space-y-3">
                        <h4 class="font-bold text-indigo-600 dark:text-indigo-400 text-xs sm:text-sm flex items-center gap-1.5">
                            <i class="fa-solid fa-lightbulb"></i> VERSO (Réponse / Schéma)
                        </h4>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Réponse ou Explication *</label>
                            <input type="text" id="input-back-title" required placeholder="Ex: Ventricule gauche & Aorte" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Photo Verso</label>
                            <div class="space-y-2">
                                <div id="dropzone-back" onclick="document.getElementById('file-back').click()" class="border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-indigo-500 dark:hover:border-indigo-500 rounded-xl p-3 text-center cursor-pointer transition flex flex-col items-center justify-center bg-white dark:bg-slate-800">
                                    <i class="fa-solid fa-camera text-xl text-slate-400 mb-1"></i>
                                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Prendre / Choisir une photo</span>
                                    <input type="file" id="file-back" accept="image/*" class="hidden" onchange="handleFileUpload(this, 'back')">
                                </div>
                                
                                <input type="url" id="input-back-url" placeholder="ou URL de l'image..." oninput="previewUrlImage('back')" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none">

                                <!-- Image Preview -->
                                <div id="preview-back-container" class="relative hidden mt-2 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900 h-28 flex items-center justify-center">
                                    <img id="preview-back-img" src="" class="max-h-full max-w-full object-contain">
                                    <button type="button" onclick="clearImage('back')" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs hover:bg-red-600 shadow">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Footer Buttons -->
                <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100 dark:border-slate-700">
                    <button type="button" onclick="closeAddModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium text-xs sm:text-sm hover:bg-slate-100 dark:hover:bg-slate-700">Annuler</button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-semibold text-xs sm:text-sm shadow-md shadow-sky-600/20">Enregistrer la carte</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= IMPORT / EXPORT MODAL ================= -->
    <div id="modal-export" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl border border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between mb-4 border-b border-slate-100 dark:border-slate-700 pb-3">
                <h3 class="text-lg font-bold text-slate-800 dark:text-white">Sauvegarde & Exportation</h3>
                <button onclick="closeExportModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Exportez vos cartes pour les sauvegarder ou importer un fichier JSON existant.</p>

            <div class="space-y-3">
                <button onclick="exportJSON()" class="w-full py-2.5 px-4 rounded-xl bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 font-semibold text-slate-800 dark:text-white text-xs sm:text-sm flex items-center justify-between transition">
                    <span class="flex items-center gap-2"><i class="fa-solid fa-download text-sky-500"></i> Télécharger le Paquet (JSON)</span>
                    <i class="fa-solid fa-chevron-right text-xs opacity-50"></i>
                </button>

                <div class="relative">
                    <button onclick="document.getElementById('file-import-json').click()" class="w-full py-2.5 px-4 rounded-xl bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 font-semibold text-slate-800 dark:text-white text-xs sm:text-sm flex items-center justify-between transition">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-upload text-indigo-500"></i> Importer un fichier JSON</span>
                        <i class="fa-solid fa-chevron-right text-xs opacity-50"></i>
                    </button>
                    <input type="file" id="file-import-json" accept=".json" class="hidden" onchange="importJSON(this)">
                </div>

                <button onclick="loadSampleCards()" class="w-full py-2.5 px-4 rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-300 font-semibold text-xs sm:text-sm flex items-center justify-between transition">
                    <span class="flex items-center gap-2"><i class="fa-solid fa-wand-magic-sparkles text-amber-500"></i> Charger les cartes d'exemples</span>
                    <i class="fa-solid fa-rotate text-xs"></i>
                </button>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-100 dark:border-slate-700 flex justify-end">
                <button onclick="closeExportModal()" class="px-4 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-700 text-xs font-semibold">Fermer</button>
            </div>
        </div>
    </div>

    <!-- Application Script -->
    <script>
        // --- DATA STATE ---
        let cards = [];
        let currentIndex = 0;
        let isFlipped = false;
        let activeTab = 'study';
        
        // Form temporary image storage
        let currentFrontImg = '';
        let currentBackImg = '';

        // Touch Swipe Handling Variables
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;

        // Default Sample Cards
        const SAMPLE_CARDS = [
            {
                id: 'sample-1',
                frontTitle: 'Système Solaire - Planète Bleue',
                frontImg: 'https://images.unsplash.com/photo-1614728894747-a83421e2b9c9?auto=format&fit=crop&w=800&q=80',
                backTitle: 'La Terre (3ème planète du Soleil)',
                backImg: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80'
            },
            {
                id: 'sample-2',
                frontTitle: 'Anatomie : Cœur Humain',
                frontImg: 'https://images.unsplash.com/photo-1530026405186-ed1f139313f8?auto=format&fit=crop&w=800&q=80',
                backTitle: 'Organe cardiaque musculaire à 4 cavités',
                backImg: 'https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&w=800&q=80'
            }
        ];

        // --- INIT ---
        window.onload = function() {
            loadCardsFromStorage();
            updateUI();
            
            // Setup Keyboard shortcuts
            document.addEventListener('keydown', (e) => {
                if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') return;
                
                if (activeTab === 'study' && cards.length > 0) {
                    if (e.code === 'Space') {
                        e.preventDefault();
                        flipCard();
                    } else if (e.code === 'ArrowRight') {
                        nextCard();
                    } else if (e.code === 'ArrowLeft') {
                        prevCard();
                    }
                }
            });

            // Touch Swipe setup for mobile
            const container = document.getElementById('flashcard-container');
            container.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
                touchStartY = e.changedTouches[0].screenY;
            }, { passive: true });

            container.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                touchEndY = e.changedTouches[0].screenY;
                handleSwipeGesture();
            }, { passive: true });

            setupDragAndDrop('dropzone-front', 'front');
            setupDragAndDrop('dropzone-back', 'back');
        };

        // --- TOUCH SWIPE LOGIC ---
        function handleSwipeGesture() {
            const diffX = touchEndX - touchStartX;
            const diffY = touchEndY - touchStartY;

            // Ensure horizontal swipe is dominant and significant (> 40px)
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                if (diffX < 0) {
                    nextCard(); // Swipe Left -> Next
                } else {
                    prevCard(); // Swipe Right -> Previous
                }
            }
        }

        // --- TOAST NOTIFICATIONS ---
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.textContent = message;
            if (type === 'error') {
                toastIcon.className = 'fa-solid fa-circle-exclamation text-red-400';
            } else if (type === 'success') {
                toastIcon.className = 'fa-solid fa-circle-check text-emerald-400';
            } else {
                toastIcon.className = 'fa-solid fa-circle-info text-sky-400';
            }

            toast.classList.remove('translate-y-[-100%]', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-[-100%]', 'opacity-0');
            }, 3000);
        }

        // --- LOCAL STORAGE MANAGEMENT ---
        function loadCardsFromStorage() {
            const saved = localStorage.getItem('flashmaster_cards');
            if (saved) {
                try {
                    cards = JSON.parse(saved);
                } catch(e) {
                    cards = [...SAMPLE_CARDS];
                }
            } else {
                cards = [...SAMPLE_CARDS];
                saveCardsToStorage();
            }
        }

        function saveCardsToStorage() {
            try {
                localStorage.setItem('flashmaster_cards', JSON.stringify(cards));
            } catch(e) {
                showToast('Espace stockage plein. Supprimez ou optimisez vos cartes.', 'error');
            }
        }

        function loadSampleCards() {
            cards = [...SAMPLE_CARDS];
            saveCardsToStorage();
            currentIndex = 0;
            updateUI();
            closeExportModal();
            showToast('Cartes d\'exemple chargées', 'success');
        }

        // --- TAB MANAGEMENT ---
        function switchTab(tab) {
            activeTab = tab;
            const studyBtn = document.getElementById('tab-study');
            const manageBtn = document.getElementById('tab-manage');
            const studySec = document.getElementById('section-study');
            const manageSec = document.getElementById('section-manage');

            if (tab === 'study') {
                studyBtn.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center gap-1.5 bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-sm";
                manageBtn.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all flex items-center gap-1.5";
                studySec.classList.remove('hidden');
                manageSec.classList.add('hidden');
                updateStudyCard();
            } else {
                manageBtn.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center gap-1.5 bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-sm";
                studyBtn.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all flex items-center gap-1.5";
                manageSec.classList.remove('hidden');
                studySec.classList.add('hidden');
                renderManageGrid();
            }
        }

        function updateUI() {
            document.getElementById('card-count-badge').textContent = cards.length;
            if (activeTab === 'study') {
                updateStudyCard();
            } else {
                renderManageGrid();
            }
        }

        // --- STUDY MODE CONTROLS ---
        function flipCard() {
            if (cards.length === 0) return;
            isFlipped = !isFlipped;
            const flipper = document.getElementById('card-flipper');
            if (isFlipped) {
                flipper.classList.add('rotate-y-180');
            } else {
                flipper.classList.remove('rotate-y-180');
            }
        }

        function unflipCardDirectly() {
            isFlipped = false;
            document.getElementById('card-flipper').classList.remove('rotate-y-180');
        }

        function updateStudyCard() {
            unflipCardDirectly();

            const emptyMsg = document.getElementById('empty-deck-msg');
            const flipper = document.getElementById('card-flipper');
            const progressText = document.getElementById('progress-text');
            const progressBar = document.getElementById('progress-bar');
            const btnPrev = document.getElementById('btn-prev');
            const btnNext = document.getElementById('btn-next');

            if (cards.length === 0) {
                emptyMsg.classList.remove('hidden');
                flipper.classList.add('hidden');
                progressText.textContent = `Carte 0 / 0`;
                progressBar.style.width = `0%`;
                btnPrev.disabled = true;
                btnNext.disabled = true;
                return;
            }

            emptyMsg.classList.add('hidden');
            flipper.classList.remove('hidden');

            const card = cards[currentIndex];

            // Set Front Content
            document.getElementById('card-front-title').textContent = card.frontTitle || 'Sans titre';
            const frontImgEl = document.getElementById('card-front-img');
            const frontPlaceholder = document.getElementById('card-front-img-placeholder');
            document.getElementById('card-front-msg').textContent = "Pas d'image recto";

            if (card.frontImg) {
                frontImgEl.src = card.frontImg;
                frontImgEl.classList.remove('hidden');
                frontPlaceholder.classList.add('hidden');
            } else {
                frontImgEl.classList.add('hidden');
                frontPlaceholder.classList.remove('hidden');
            }

            // Set Back Content
            document.getElementById('card-back-title').textContent = card.backTitle || 'Sans réponse';
            const backImgEl = document.getElementById('card-back-img');
            const backPlaceholder = document.getElementById('card-back-img-placeholder');
            document.getElementById('card-back-msg').textContent = "Pas d'image verso";

            if (card.backImg) {
                backImgEl.src = card.backImg;
                backImgEl.classList.remove('hidden');
                backPlaceholder.classList.add('hidden');
            } else {
                backImgEl.classList.add('hidden');
                backPlaceholder.classList.remove('hidden');
            }

            // Controls update
            progressText.textContent = `Carte ${currentIndex + 1} / ${cards.length}`;
            const percent = ((currentIndex + 1) / cards.length) * 100;
            progressBar.style.width = `${percent}%`;

            btnPrev.disabled = currentIndex === 0;
            btnNext.disabled = currentIndex === cards.length - 1;
        }

        function onImgError(imgEl, side) {
            imgEl.classList.add('hidden');
            const placeholder = document.getElementById(`card-${side}-img-placeholder`);
            const msgEl = document.getElementById(`card-${side}-msg`);
            msgEl.textContent = "Erreur de chargement photo";
            placeholder.classList.remove('hidden');
        }

        function nextCard() {
            if (currentIndex < cards.length - 1) {
                currentIndex++;
                updateStudyCard();
            }
        }

        function prevCard() {
            if (currentIndex > 0) {
                currentIndex--;
                updateStudyCard();
            }
        }

        function shuffleDeck() {
            if (cards.length <= 1) return;
            for (let i = cards.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [cards[i], cards[j]] = [cards[j], cards[i]];
            }
            currentIndex = 0;
            saveCardsToStorage();
            updateStudyCard();
            showToast('Paquet mélangé', 'info');
        }

        function resetStudyProgress() {
            currentIndex = 0;
            updateStudyCard();
        }

        // --- CARD MANAGEMENT GRID ---
        function renderManageGrid() {
            const grid = document.getElementById('cards-grid');
            grid.innerHTML = '';

            if (cards.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-400">
                        <i class="fa-solid fa-folder-open text-4xl mb-3"></i>
                        <p class="text-base font-medium">Votre collection est vide.</p>
                        <button onclick="openAddModal()" class="mt-3 px-4 py-2 bg-sky-600 text-white font-medium text-sm rounded-xl">Créer une carte</button>
                    </div>
                `;
                return;
            }

            cards.forEach((card, idx) => {
                const cardEl = document.createElement('div');
                cardEl.className = "bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm flex flex-col justify-between hover:shadow-md transition";
                
                cardEl.innerHTML = `
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-400">#${idx + 1}</span>
                            <div class="flex items-center gap-1">
                                <button onclick="openEditModal('${card.id}')" class="w-8 h-8 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center text-xs" title="Éditer">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button onclick="deleteCard('${card.id}')" class="w-8 h-8 rounded-lg text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30 flex items-center justify-center text-xs" title="Supprimer">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Card Mini Previews -->
                        <div class="grid grid-cols-2 gap-2 text-xs">
                            <!-- Recto Preview -->
                            <div class="bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-100 dark:border-slate-700 flex flex-col items-center">
                                <span class="text-[10px] uppercase font-bold text-sky-500 mb-1">Recto</span>
                                ${card.frontImg ? `<img src="${card.frontImg}" class="h-16 w-full object-contain mb-1 rounded" onerror="this.style.display='none'">` : '<div class="h-16 flex items-center text-slate-300"><i class="fa-regular fa-image text-xl"></i></div>'}
                                <p class="font-medium text-slate-700 dark:text-slate-300 text-center truncate w-full" title="${card.frontTitle}">${card.frontTitle}</p>
                            </div>
                            
                            <!-- Verso Preview -->
                            <div class="bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-100 dark:border-slate-700 flex flex-col items-center">
                                <span class="text-[10px] uppercase font-bold text-indigo-500 mb-1">Verso</span>
                                ${card.backImg ? `<img src="${card.backImg}" class="h-16 w-full object-contain mb-1 rounded" onerror="this.style.display='none'">` : '<div class="h-16 flex items-center text-slate-300"><i class="fa-regular fa-image text-xl"></i></div>'}
                                <p class="font-medium text-slate-700 dark:text-slate-300 text-center truncate w-full" title="${card.backTitle}">${card.backTitle}</p>
                            </div>
                        </div>
                    </div>
                `;
                grid.appendChild(cardEl);
            });
        }

        // --- ADD / EDIT MODAL LOGIC ---
        function openAddModal() {
            document.getElementById('card-id').value = '';
            document.getElementById('modal-title').textContent = 'Nouvelle Flashcard';
            document.getElementById('input-front-title').value = '';
            document.getElementById('input-back-title').value = '';
            document.getElementById('input-front-url').value = '';
            document.getElementById('input-back-url').value = '';
            
            clearImage('front');
            clearImage('back');

            document.getElementById('modal-card').classList.remove('hidden');
        }

        function openEditModal(id) {
            const card = cards.find(c => c.id === id);
            if (!card) return;

            document.getElementById('card-id').value = card.id;
            document.getElementById('modal-title').textContent = 'Modifier la Flashcard';
            document.getElementById('input-front-title').value = card.frontTitle || '';
            document.getElementById('input-back-title').value = card.backTitle || '';
            
            currentFrontImg = card.frontImg || '';
            currentBackImg = card.backImg || '';

            if (currentFrontImg) {
                if (currentFrontImg.startsWith('http')) {
                    document.getElementById('input-front-url').value = currentFrontImg;
                }
                showPreview('front', currentFrontImg);
            } else {
                clearImage('front');
            }

            if (currentBackImg) {
                if (currentBackImg.startsWith('http')) {
                    document.getElementById('input-back-url').value = currentBackImg;
                }
                showPreview('back', currentBackImg);
            } else {
                clearImage('back');
            }

            document.getElementById('modal-card').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('modal-card').classList.add('hidden');
        }

        // --- IMAGE HANDLING WITH RESIZING & COMPRESSION ---
        function handleFileUpload(input, side) {
            const file = input.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 750;
                    const MAX_HEIGHT = 750;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > MAX_WIDTH) {
                            height *= MAX_WIDTH / width;
                            width = MAX_WIDTH;
                        }
                    } else {
                        if (height > MAX_HEIGHT) {
                            width *= MAX_HEIGHT / height;
                            height = MAX_HEIGHT;
                        }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.7);

                    if (side === 'front') {
                        currentFrontImg = compressedDataUrl;
                        document.getElementById('input-front-url').value = '';
                    } else {
                        currentBackImg = compressedDataUrl;
                        document.getElementById('input-back-url').value = '';
                    }
                    showPreview(side, compressedDataUrl);
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function setupDragAndDrop(elementId, side) {
            const dropzone = document.getElementById(elementId);
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, preventDefaults, false);
            });

            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }

            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, () => dropzone.classList.add('border-sky-500'), false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, () => dropzone.classList.remove('border-sky-500'), false);
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files.length > 0) {
                    const fileInput = document.getElementById(`file-${side}`);
                    fileInput.files = files;
                    handleFileUpload(fileInput, side);
                }
            });
        }

        function previewUrlImage(side) {
            const url = document.getElementById(`input-${side}-url`).value.trim();
            if (url) {
                if (side === 'front') currentFrontImg = url;
                else currentBackImg = url;
                showPreview(side, url);
            } else {
                clearImage(side);
            }
        }

        function showPreview(side, src) {
            const container = document.getElementById(`preview-${side}-container`);
            const img = document.getElementById(`preview-${side}-img`);
            img.onerror = () => {
                showToast('Erreur chargement d\'image', 'error');
            };
            img.src = src;
            container.classList.remove('hidden');
        }

        function clearImage(side) {
            if (side === 'front') {
                currentFrontImg = '';
                document.getElementById('input-front-url').value = '';
                document.getElementById('file-front').value = '';
            } else {
                currentBackImg = '';
                document.getElementById('input-back-url').value = '';
                document.getElementById('file-back').value = '';
            }
            document.getElementById(`preview-${side}-container`).classList.add('hidden');
        }

        // --- FORM SUBMIT ---
        function saveCardForm(e) {
            e.preventDefault();

            const id = document.getElementById('card-id').value;
            const frontTitle = document.getElementById('input-front-title').value.trim();
            const backTitle = document.getElementById('input-back-title').value.trim();

            if (id) {
                // Edit existing
                const card = cards.find(c => c.id === id);
                if (card) {
                    card.frontTitle = frontTitle;
                    card.backTitle = backTitle;
                    card.frontImg = currentFrontImg;
                    card.backImg = currentBackImg;
                }
            } else {
                // Create new
                const newCard = {
                    id: 'card-' + Date.now(),
                    frontTitle: frontTitle,
                    backTitle: backTitle,
                    frontImg: currentFrontImg,
                    backImg: currentBackImg
                };
                cards.push(newCard);
            }

            saveCardsToStorage();
            closeAddModal();
            updateUI();
            showToast('Carte enregistrée !', 'success');
        }

        function deleteCard(id) {
            cards = cards.filter(c => c.id !== id);
            if (currentIndex >= cards.length && currentIndex > 0) {
                currentIndex = cards.length - 1;
            }
            saveCardsToStorage();
            updateUI();
            showToast('Carte supprimée', 'info');
        }

        // --- EXPORT & IMPORT JSON ---
        function openExportModal() {
            document.getElementById('modal-export').classList.remove('hidden');
        }

        function closeExportModal() {
            document.getElementById('modal-export').classList.add('hidden');
        }

        function exportJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(cards, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `flashmaster-deck-${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importJSON(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const importedCards = JSON.parse(e.target.result);
                        if (Array.isArray(importedCards)) {
                            cards = importedCards;
                            saveCardsToStorage();
                            currentIndex = 0;
                            updateUI();
                            closeExportModal();
                            showToast('Paquet importé avec succès !', 'success');
                        } else {
                            showToast('Fichier JSON invalide', 'error');
                        }
                    } catch(err) {
                        showToast('Erreur de lecture du JSON', 'error');
                    }
                };
                reader.readAsText(file);
            }
        }

        // --- DARK MODE TOGGLE ---
        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            const icon = document.getElementById('theme-icon');
            if (isDark) {
                icon.className = 'fa-solid fa-sun text-amber-400 text-xs sm:text-sm';
            } else {
                icon.className = 'fa-solid fa-moon text-xs sm:text-sm';
            }
        }
    </script>
</body>
